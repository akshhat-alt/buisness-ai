# Business AI — environment configuration template.
# Copy to .env for local development. Never commit real secrets.

# ==============================================================================
# Required
# ==============================================================================
OPENAI_API_KEY=your-openai-api-key-here

# ==============================================================================
# Auth & Security
# ==============================================================================
# 32+ random bytes in production. Below this length, or a value on the known
# weak-secret denylist, startup fails closed when AUTH_REQUIRED=true.
JWT_SECRET_KEY=change-me-to-a-real-32-byte-secret-in-production
JWT_ISSUER=business-ai-auth
JWT_AUDIENCE=business-ai-api
# Platform-admin login secret — required to activate a new business's assistant.
ADMIN_SECRET=change-me-to-a-real-admin-secret

# Encrypts a tenant's WhatsApp access token / Razorpay key secret at rest
# (Phase 9). Any string works (hashed down to a valid key internally,
# same ergonomics as the two secrets above). Leave blank to keep those
# fields plaintext, exactly as every tenant before this setting existed —
# after setting it, run `python scripts/rotate_secrets.py --apply` once
# to encrypt already-stored secrets immediately instead of waiting for
# each tenant to be naturally re-saved.
SECRET_ENCRYPTION_KEY=

# Set true in production (Railway). When true, weak/default secrets above
# cause the app to refuse to start rather than run insecurely.
AUTH_REQUIRED=false
APP_ENV=development

# Comma-separated allowed origins for CORS. Never use "*" in production.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ==============================================================================
# AI Models
# ==============================================================================
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
MAX_OUTPUT_TOKENS=800

# ==============================================================================
# Session Quotas & Rate Limiting (mirrors Shri AI's proven, tested pattern)
# ==============================================================================
# Default per-session allowance for a real ACTIVE business tenant.
ACTIVE_TENANT_QUESTION_LIMIT=500
REQUESTS_PER_MINUTE=2
MAX_CONCURRENT_REQUESTS_PER_SESSION=1
MAX_QUERY_LENGTH=1000
# Phase 9: app-wide abuse guards ahead of the per-session quota above —
# a single IP minting new session ids, or one tenant's total request
# volume across every session, neither of which the per-session counter
# alone can catch. Deliberately generous (a dashboard page load alone
# fires a dozen-plus API calls) — an abuse guard, not a tight quota.
# 0 disables that dimension.
IP_REQUESTS_PER_MINUTE=120
TENANT_REQUESTS_PER_MINUTE=300

# ==============================================================================
# WhatsApp handoff (wa.me click-to-chat link shown by the website widget)
# ==============================================================================
# Fallback WhatsApp number (E.164, no "+") shown when a tenant hasn't set
# their own. Leave blank to disable the fallback.
DEFAULT_WHATSAPP_NUMBER=

# ==============================================================================
# WhatsApp Business Cloud API (platform-level — ONE shared Meta App for
# every tenant; each tenant brings their OWN phone_number_id + access
# token, set per-tenant from their dashboard, not here). See README.md
# "WhatsApp setup" for the full walkthrough.
# ==============================================================================
# Meta App Secret — verifies the X-Hub-Signature-256 header on every
# inbound webhook call, so a request can't be forged by anyone who
# doesn't also know this. Required for the webhook to accept any traffic.
WHATSAPP_APP_SECRET=
# Any random string YOU choose — enter the SAME value in Meta's webhook
# config UI. Meta echoes it back on the one-time verification handshake;
# this app only proceeds if it matches.
WHATSAPP_VERIFY_TOKEN=
# Graph API version to call. Bump when Meta deprecates an older version.
WHATSAPP_API_VERSION=v21.0
# WhatsApp Embedded Signup ("Connect WhatsApp" one-click onboarding).
# Requires Business AI to be an approved Meta Tech Provider — until
# that's done, leave both blank. The manual connection flow above
# (per-tenant, from their own dashboard) always works regardless.
WHATSAPP_APP_ID=
# Configuration ID from the Meta App dashboard -> WhatsApp -> Embedded
# Signup. Both this and WHATSAPP_APP_ID are required together for the
# "Connect WhatsApp" button to appear in onboarding.
WHATSAPP_CONFIG_ID=

# ==============================================================================
# Transactional email (V1.1, optional) — owner digest, real-time
# dissatisfaction alerts, and customer review requests all use this.
# ==============================================================================
# Sent via Resend (https://resend.com). Leave both blank to skip all of
# the above gracefully — POST /api/v1/admin/digest/run returns a
# "not configured" note, and the dissatisfaction alert/review-request
# paths no-op or return a clear 400 instead of failing the request.
RESEND_API_KEY=
DIGEST_FROM_EMAIL=
# How far back "today's activity" looks when the digest runs.
DIGEST_WINDOW_HOURS=24
# Used to build the "Open your dashboard" link in the digest and alert
# emails. Leave blank to omit the link.
PUBLIC_BASE_URL=
# Notifies you when a new business signs up (otherwise only visible by
# checking the admin panel yourself), notifies the OWNER when a tenant
# is activated (by you or by themselves), and receives a courtesy notice
# when an owner self-activates. Leave blank to skip all three gracefully.
PLATFORM_ADMIN_EMAIL=

# ==============================================================================
# Business AI's OWN subscription billing (V1.5) — collecting payment FROM
# tenants for using Business AI itself. Separate from a tenant's own
# Razorpay credentials (set per-tenant, from their dashboard), which
# collect deposits from THAT tenant's own customers. Leave blank to
# disable billing links entirely — tenants without a price ever set on
# them activate exactly as before, unaffected.
# ==============================================================================
PLATFORM_RAZORPAY_KEY_ID=
PLATFORM_RAZORPAY_KEY_SECRET=
# Set in Razorpay's dashboard under Settings -> Webhooks (same value in
# both places) to auto-confirm platform subscription payments the moment
# they're paid, instead of waiting on an admin to check their own
# Razorpay dashboard and click "Mark Paid". Leave blank to keep the
# manual-confirmation flow only.
PLATFORM_RAZORPAY_WEBHOOK_SECRET=
# Phase 8 self-serve onboarding: the price (whole rupees) shown to a new
# owner during setup, with a real "Pay Now" button generating a real
# Razorpay payment link. Leave blank to skip the payment step entirely —
# every tenant activates for free, exactly like today.
PLATFORM_SUBSCRIPTION_PRICE_INR=

# ==============================================================================
# Growth automations (V1.2): missed-lead re-engagement, appointment
# reminders, deposit links, and customer win-back. All four run as
# platform-admin endpoints (/api/v1/admin/{reengagement,reminders,
# winback}/run) meant to be hit once a day by an external cron — same
# shape as the digest above. Deposit links use each TENANT's own
# Razorpay credentials (set from their dashboard, not here).
# ==============================================================================
# Platform-wide default for "how many days without a repeat visit counts
# as lapsed" — a tenant can override this from their own dashboard.
WINBACK_DEFAULT_DAYS=45

# ==============================================================================
# Review aggregation (Phase 25) — optional. A PLATFORM-level Google Cloud
# API key with the Places API enabled, billed to the platform operator
# (each tenant only sets their own Google Place ID from their dashboard).
# Unset = the automated Google-review sync cron skips every tenant
# gracefully; manual review logging ("log review zomato 4.3 128") is
# completely unaffected either way.
GOOGLE_PLACES_API_KEY=

# ==============================================================================
# Server
# ==============================================================================
PORT=8000
# Instant kill switch — set to false to pause all AI operations without a
# redeploy (e.g. a cost spike or incident).
BUSINESS_AI_ENABLED=true
