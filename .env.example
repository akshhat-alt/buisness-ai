# Business AI — environment configuration template.
# Copy to .env for local development. Never commit real secrets.

# ==============================================================================
# Required
# ==============================================================================
OPENAI_API_KEY=your-openai-api-key-here

# ==============================================================================
# Auth & Security
# ==============================================================================
# 32+ random bytes in production. Below this length, or a value on the known
# weak-secret denylist, startup fails closed when AUTH_REQUIRED=true.
JWT_SECRET_KEY=change-me-to-a-real-32-byte-secret-in-production
JWT_ISSUER=business-ai-auth
JWT_AUDIENCE=business-ai-api
# Platform-admin login secret — required to activate a new business's assistant.
ADMIN_SECRET=change-me-to-a-real-admin-secret

# Set true in production (Railway). When true, weak/default secrets above
# cause the app to refuse to start rather than run insecurely.
AUTH_REQUIRED=false
APP_ENV=development

# Comma-separated allowed origins for CORS. Never use "*" in production.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ==============================================================================
# AI Models
# ==============================================================================
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
MAX_OUTPUT_TOKENS=800

# ==============================================================================
# Session Quotas & Rate Limiting (mirrors Shri AI's proven, tested pattern)
# ==============================================================================
# Default per-session allowance for a real ACTIVE business tenant.
ACTIVE_TENANT_QUESTION_LIMIT=500
REQUESTS_PER_MINUTE=2
MAX_CONCURRENT_REQUESTS_PER_SESSION=1
MAX_QUERY_LENGTH=1000

# ==============================================================================
# WhatsApp handoff (v1: click-to-chat links only, no Business API automation)
# ==============================================================================
# Fallback WhatsApp number (E.164, no "+") shown when a tenant hasn't set
# their own. Leave blank to disable the fallback.
DEFAULT_WHATSAPP_NUMBER=

# ==============================================================================
# Transactional email (V1.1, optional) — owner digest, real-time
# dissatisfaction alerts, and customer review requests all use this.
# ==============================================================================
# Sent via Resend (https://resend.com). Leave both blank to skip all of
# the above gracefully — POST /api/v1/admin/digest/run returns a
# "not configured" note, and the dissatisfaction alert/review-request
# paths no-op or return a clear 400 instead of failing the request.
RESEND_API_KEY=
DIGEST_FROM_EMAIL=
# How far back "today's activity" looks when the digest runs.
DIGEST_WINDOW_HOURS=24
# Used to build the "Open your dashboard" link in the digest and alert
# emails. Leave blank to omit the link.
PUBLIC_BASE_URL=

# ==============================================================================
# Server
# ==============================================================================
PORT=8000
# Instant kill switch — set to false to pause all AI operations without a
# redeploy (e.g. a cost spike or incident).
BUSINESS_AI_ENABLED=true
